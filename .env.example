# ==============================================================================
# Orbital Sentinel - Environment Configuration
# Copy this file to .env and fill in your API keys
# ==============================================================================

# Google Gemini API Key
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key
# Get from: https://elevenlabs.io/api
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Confluent Kafka Configuration
# Get from: https://confluent.cloud/
KAFKA_BOOTSTRAP_SERVERS=your_kafka_bootstrap_servers
KAFKA_API_KEY=your_kafka_api_key
KAFKA_API_SECRET=your_kafka_api_secret
KAFKA_TOPIC=orbital-sentinel-risks

# Backend API Configuration
BACKEND_HOST=localhost
BACKEND_PORT=8000

# Frontend Configuration
STREAMLIT_PORT=8501

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Simulation Mode (set to true to use simulated data without real Kafka)
SIMULATION_MODE=true
