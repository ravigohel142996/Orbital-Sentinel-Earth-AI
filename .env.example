# ==============================================================================
# Orbital Sentinel - Environment Configuration
# Copy this file to .env and fill in your API keys
# ==============================================================================

# Google Gemini API Key
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key
# Get from: https://elevenlabs.io/api
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Confluent Kafka Configuration
# Get from: https://confluent.cloud/
KAFKA_BOOTSTRAP_SERVERS=your_kafka_bootstrap_servers
KAFKA_API_KEY=your_kafka_api_key
KAFKA_API_SECRET=your_kafka_api_secret
KAFKA_TOPIC=orbital-sentinel-risks

# Backend API Configuration
# Use 0.0.0.0 to allow connections from any interface (required for containers/deployment)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Configuration
# Comma-separated list of allowed origins, or "*" for all origins
# For production, specify your frontend domain(s) e.g., "https://your-app.com,https://www.your-app.com"
ALLOWED_ORIGINS=*

# Frontend Configuration
STREAMLIT_PORT=8501

# API Base URL for Frontend to reach Backend
# For local development: http://localhost:8000
# For deployment: Set to your deployed backend URL (e.g., https://api.your-domain.com)
API_BASE_URL=http://localhost:8000

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Simulation Mode (set to true to use simulated data without real Kafka)
SIMULATION_MODE=true
